# Copy this file to ".env" (same folder) and fill in your real values.
# ".env" itself should never be committed to git or shared with the client —
# it holds a live credential.

# --- Option A: Bedrock API key (bearer token) ---
# The key you generated from the Bedrock console's "API keys" page.
AWS_BEARER_TOKEN_BEDROCK=

# --- Option B: classic AWS credentials (only needed if you're not using the API key above) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Model + region ---
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=qwen.qwen3-vl-235b-a22b

# --- Optional: force the old hardcoded sample reading (e.g. demoing with no internet) ---
# CNIC_OCR_MODE=stub
